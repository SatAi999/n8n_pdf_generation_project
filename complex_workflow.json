      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        400
      ]
    },
    {
      "parameters": {
        "filePath": "D:/n8n_pdf/Anuj Jindal Task/Notes Economic Growth and Development 118b820004a246028d53c0d80e25b5f3.html",
        "dataPropertyName": "htmlData"
      },
      "id": "read-html-file-prod",
      "name": "Load Source HTML",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        320,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/render-pdf",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyFormat": "multipart",
        "parametersToSend": {
          "parameter": [
            {
              "name": "htmlFile",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "htmlData"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "pdfData"
            }
          }
        },
        "responseData": "file",
        "responseBinaryPropertyName": "pdfData"
      },
      "id": "http-request-pdf-service",
      "name": "Call PDF Microservice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        540,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $binary.pdfData.mimeType }}",
              "value2": "application/pdf"
            }
          ]
        }
      },
      "id": "if-valid-pdf",
      "name": "Validate PDF Response",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        760,
        320
      ]
    },
    {
      "parameters": {
        "fileName": "D:/n8n_pdf/Economic Growth and Development.pdf",
        "binaryPropertyName": "pdfData"
      },
      "id": "write-pdf-file-prod",
      "name": "Save PDF to Disk",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        980,
        240
      ]
    },
    {
      "parameters": {
        "infoMessage": "PDF generated and saved successfully!"
      },
      "id": "success-log-node",
      "name": "Success Summary",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {
        "errorMessage": "PDF generation failed or returned invalid content type."
      },
      "id": "fail-log-node",
      "name": "Error Handler",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        980,
        400
      ]
    },
    {
      "parameters": {},
      "id": "error-trigger-prod",
      "name": "Error Trigger (System Alert)",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        760,
        560
      ]
    }
  ],
